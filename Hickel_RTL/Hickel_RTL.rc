
#define _X86_

//
// Include the necessary resources
//
#include <winver.h>
#include <ntdef.h>

#ifdef RC_INVOKED

//
// Set up debug information
//
#if DBG
#define VER_DBG VS_FF_DEBUG
#else
#define VER_DBG 0
#endif

// ------- version info -------------------------------------------------------

// Wir machen die Versionsinfo selbst, weil
// Delphi 11 irgendwie einen Bug hat (die Versionsinfo wird nicht angezeigt und ist immer Englisch)
// Außerdem ist der Jahreswechsel einfacher, wenn wir nicht uns durch die GUI klicken müssen...

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN
VS_VERSION_INFO VERSIONINFO
FILEVERSION             9,0,30,3
PRODUCTVERSION          9,0,30,3
FILEFLAGSMASK           VS_FFI_FILEFLAGSMASK
FILEFLAGS               VER_DBG
FILEOS                  VOS_NT_WINDOWS32
FILETYPE                VFT_DLL
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040704E4"
        BEGIN
			VALUE "CompanyName",      "HickelSOFT Huth GmbH"
			VALUE "FileDescription",  "HickelSOFT Runtime Library"
			VALUE "FileVersion",      "9.0.30.3"
			VALUE "InternalName",     "Hickel RTL"
			VALUE "LegalCopyright",   "(C) 1992-2026 HickelSOFT Huth GmbH"
			VALUE "LegalTrademarks",  "CORAplus"
			VALUE "OriginalFilename", "Hickel_RTL.bpl"
			VALUE "ProductName",      "CORAplus 2026"
			VALUE "ProductVersion",	  "9.0.30.3"
			VALUE "Comments",         ""
        END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0407, 0x04E4
	END
END
#endif
